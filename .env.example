# Copier en .env (gitignored) et renseigner les valeurs réelles.

# --- apps/api ---
# Connection string Neon (branche personnelle en local, jamais la branche main/production).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
PORT=3001
APP_ENV=local
# SHA du commit courant, affiché par /health. Optionnel en local.
COMMIT_SHA=local

# --- apps/web ---
VITE_API_URL=http://localhost:3001

# --- Réservé, pas encore utilisé (M8 — intégration OKX) ---
# Clé API OKX strictement en lecture seule. Ne jamais l'exposer au frontend.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
